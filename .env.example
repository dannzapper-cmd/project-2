# SnapInsight analysis backend configuration
#
# Production/demo: set SNAPINSIGHT_ANALYSIS_MODE=gemini
#   and provide GEMINI_API_KEY.
# Development/CI: SNAPINSIGHT_ANALYSIS_MODE=mock,
#   GEMINI_API_KEY not required.
# SNAPINSIGHT_ALLOW_MOCK_FALLBACK=true only for controlled demo
#   environments. Keep false in production.

SNAPINSIGHT_ANALYSIS_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SNAPINSIGHT_ALLOW_MOCK_FALLBACK=false

# Frontend local API target
NEXT_PUBLIC_SNAPINSIGHT_API_URL=http://127.0.0.1:8000
