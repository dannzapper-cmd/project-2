# SnapInsight frontend (Vercel / local Next.js)
# Copy to .env.local for local development. Never commit real secrets.

# Required for production/preview builds that call the deployed API
NEXT_PUBLIC_SNAPINSIGHT_API_URL=http://127.0.0.1:8000

# Optional: only if you explicitly enable Gemini Live on the backend (off by default)
# NEXT_PUBLIC_SNAPINSIGHT_LIVE_ACCESS_CODE=

# NEVER put GEMINI_API_KEY or other server secrets in NEXT_PUBLIC_* variables.
