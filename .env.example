# SnapInsight environment example.
# Copy values into the appropriate host dashboard; do not commit real secrets.

###############################################################################
# Vercel frontend (set for Production, Preview, and Development as needed)
###############################################################################

NEXT_PUBLIC_SNAPINSIGHT_API_URL=https://your-backend.onrender.com

###############################################################################
# Render/FastAPI backend (server-side only)
###############################################################################

SNAPINSIGHT_ANALYSIS_MODE=mock
SNAPINSIGHT_ALLOW_MOCK_FALLBACK=false
SNAPINSIGHT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-production-frontend.vercel.app
# Example scoped preview regex for this owner/project; replace with your exact
# Vercel owner/team slug. Do not use a broad pattern such as all *.vercel.app.
SNAPINSIGHT_ALLOWED_ORIGIN_REGEX=^https://project-2-[a-z0-9-]+-dannzapper-1603s-projects\.vercel\.app$
SNAPINSIGHT_CACHE_ENABLED=true
SNAPINSIGHT_CACHE_TTL_SECONDS=900
SNAPINSIGHT_CACHE_MAX_ENTRIES=50
SNAPINSIGHT_MAX_IMAGE_MB=8
SNAPINSIGHT_GRAPH_ENABLED=true

# Required only when SNAPINSIGHT_ANALYSIS_MODE=gemini.
GEMINI_API_KEY=replace-with-render-secret
GEMINI_MODEL=gemini-2.5-flash

# Optional Neo4j Aura graph sync. Keep all values server-side.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Optional Langfuse LLMOps. Keep secret key server-side.
SNAPINSIGHT_LLMOPS_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=render-prod

# Gemini Live remains disabled until a later activation step.
SNAPINSIGHT_GEMINI_LIVE_ENABLED=false
SNAPINSIGHT_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
SNAPINSIGHT_LIVE_ACCESS_CODE=
SNAPINSIGHT_LIVE_MAX_SESSION_SECONDS=120
SNAPINSIGHT_LIVE_MAX_FRAMES_PER_SECOND=1
SNAPINSIGHT_LIVE_AUDIO_ENABLED=true
SNAPINSIGHT_LIVE_VISION_ENABLED=true
# SnapInsight analysis backend configuration
#
# Production/demo: set SNAPINSIGHT_ANALYSIS_MODE=gemini
#   and provide GEMINI_API_KEY.
# Development/CI: SNAPINSIGHT_ANALYSIS_MODE=mock,
#   GEMINI_API_KEY not required.
# SNAPINSIGHT_ALLOW_MOCK_FALLBACK=true only for controlled demo
#   environments. Keep false in production.

SNAPINSIGHT_ANALYSIS_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SNAPINSIGHT_ALLOW_MOCK_FALLBACK=false

# Backend CORS. When unset, the backend allows only http://localhost:3000.
# Set to the deployed frontend origin in hosted environments.
SNAPINSIGHT_ALLOWED_ORIGINS=http://localhost:3000

# Backend host platforms commonly inject PORT. Local default remains 8000.
PORT=8000

# In-memory analysis cache (no database/Redis). Stores analysis responses only,
# keyed by a SHA-256 hash of image bytes + mode + model; never raw images.
SNAPINSIGHT_CACHE_ENABLED=true
SNAPINSIGHT_CACHE_TTL_SECONDS=900
SNAPINSIGHT_CACHE_MAX_ENTRIES=50
# Max upload size; oversized uploads are rejected before analysis/caching.
SNAPINSIGHT_MAX_IMAGE_MB=8

# Product Knowledge Graph (Block 18A). Builds an ephemeral evidence graph from
# each analysis. Falls back to in-memory when Neo4j is disabled or unset.
SNAPINSIGHT_GRAPH_ENABLED=true
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Frontend API target. Required for production builds/deploys.
NEXT_PUBLIC_SNAPINSIGHT_API_URL=http://127.0.0.1:8000
