# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# turbo
.turbo/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# tuning pipeline (Block 18C) — never commit model artifacts or generated outputs
/tuning/outputs/
tuning/outputs/
# model weights / adapters / checkpoints (any location)
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.ckpt
**/*.gguf
**/*.onnx
**/*.h5
**/*.npz
**/adapter_model.*
**/adapter_config.json
**/*.lora
# generated real eval reports (templates are committed, real runs are not)
tuning/reports/eval_report*.md
tuning/reports/*_eval_report.md
!tuning/reports/example_eval_report.md
# experiment trackers / run logs (in case a trainer enables them)
wandb/
mlruns/
runs/
lightning_logs/
.neptune/
# python caches / notebook checkpoints
.pytest_cache/
.ipynb_checkpoints/
__pycache__/
*.py[cod]

# typescript
*.tsbuildinfo
next-env.d.ts
